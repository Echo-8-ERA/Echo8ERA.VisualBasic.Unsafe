<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Echo8ERA.VisualBasic.Unsafe</RootNamespace>
		<TargetFramework>netstandard2.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

	<PropertyGroup>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>$(SolutionRoot)\Echo8ERA.VisualBasic.Unsafe.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

</Project>
